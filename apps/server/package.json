{
  "name": "@hearloom/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "AGPL-3.0-only",
  "scripts": {
    "dev": "bun --env-file=../../.env --watch src/index.ts",
    "start": "bun --env-file=../../.env src/index.ts",
    "create-user": "bun --env-file=../../.env src/scripts/create-user.ts",
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun --env-file=../../.env test",
    "simulate-phone": "bun --env-file=../../.env src/scripts/simulate-phone.ts",
    "download-models": "bun --env-file=../../.env src/scripts/download-models.ts",
    "worker": "bun --env-file=../../.env src/worker/main.ts",
    "dev:worker": "bun --env-file=../../.env --watch src/worker/main.ts",
    "build:diarizer": "cd ../../sidecars/diarizer && swift build -c release"
  },
  "dependencies": {
    "@hearloom/api": "workspace:*",
    "@hearloom/db": "workspace:*",
    "@hearloom/shared": "workspace:*",
    "@orpc/server": "1.15.4",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.3",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "mediabunny": "1.61.3",
    "zod": "4.6.5",
    "@hearloom/audio": "workspace:*",
    "@hearloom/inference": "workspace:*",
    "pg-boss": "12.36.0",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@orpc/client": "1.15.4"
  }
}

# --- Database (infra/docker-compose.yml) ---
DATABASE_URL=postgres://hearloom:hearloom@localhost:5432/hearloom

# --- Server ---
# 32+ random chars: `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# How phones and browsers reach this server, e.g. https://mac.your-tailnet.ts.net
PUBLIC_URL=http://localhost:3000
PORT=3000
# Vite dev server origin (only needed in development)
TRUSTED_ORIGINS=http://localhost:5173
# DATA_DIR=./data

# --- Apple Push Notifications (optional until you test push) ---
# Create a key at developer.apple.com > Keys (enable APNs), download the .p8.
# APNS_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=me.weish.hearloom

# --- Live pipeline (local models: pnpm --filter @hearloom/server download-models) ---
# Soniox real-time transcription for fresh audio (EN/NL code-switching, speakers).
# Without a key, everything is transcribed locally with Parakeet v3.
# SONIOX_API_KEY=
LANGUAGE_HINTS=en,nl
# LIVE_PIPELINE=on
# SPEAKER_MATCH_THRESHOLD=0.6

# --- Refine pass (worker: pnpm --filter @hearloom/server worker) ---
# Re-diarizes each finished conversation on the Mac (build sidecars/diarizer first).
# With an ElevenLabs key it also re-transcribes with Scribe v2 (better text, audio-event tags).
# ELEVENLABS_API_KEY=
# Zero retention (no logging at ElevenLabs) needs an enterprise plan; set true to allow logging.
# ELEVENLABS_ENABLE_LOGGING=false
# REFINE_PROVIDER=auto

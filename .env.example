# --- Database (infra/docker-compose.yml) ---
DATABASE_URL=postgres://hearloom:hearloom@localhost:5432/hearloom
# Hosted Postgres 18 (Neon, PlanetScale): use the direct, non-pooled URL (LISTEN/NOTIFY) with
# ?sslmode=verify-full and no sslrootcert (the drivers verify against built-in root certificates).
# Hearloom uses at most 15 connections.
# Tests (`pnpm test`) use TEST_DATABASE_URL, or DATABASE_URL only if it is on localhost. They create and
# delete rows and close open conversations, so never point them at a database you use.
# TEST_DATABASE_URL=postgres://hearloom:hearloom@localhost:5432/hearloom_test

# --- Server ---
# 32+ random chars: `openssl rand -base64 48`
BETTER_AUTH_SECRET=
# How phones, browsers and agents reach this server. Over Tailscale (README, "Remote access"): run
# `pnpm start` and `tailscale serve --bg --https=443 http://127.0.0.1:3000`, then
# PUBLIC_URL=https://<machine>.<tailnet>.ts.net
PUBLIC_URL=http://localhost:3000
PORT=3000
# Every address by default. Behind tailscale serve, 127.0.0.1: reachable only through it (no LAN, no plain
# HTTP on the tailnet address).
# HOST=127.0.0.1
# Auth trusts the address each request came in on (directly, via tailscale serve or Vite's dev proxy) when
# that's an IP, localhost, a single-label or *.ts.net name, or PUBLIC_URL's host. List other origins
# allowed to sign in here, comma-separated: another name for this server (mac.local, your own domain), or
# a console served from elsewhere.
TRUSTED_ORIGINS=
# DATA_DIR=./data

# --- Apple Push Notifications (optional until you test push) ---
# Create a key at developer.apple.com > Keys (enable APNs), download the .p8.
# APNS_KEY_PATH=/absolute/path/AuthKey_XXXXXXXXXX.p8
# APNS_KEY_ID=XXXXXXXXXX
# APNS_TEAM_ID=XXXXXXXXXX
APNS_BUNDLE_ID=me.weish.hearloom

# --- Live pipeline (local models: pnpm --filter @hearloom/server download-models) ---
# Soniox transcribes everything: real-time for fresh audio (EN/NL code-switching, speakers), async
# for backlog uploaded late. Required unless LIVE_ASR=off; there is no local fallback.
# SONIOX_API_KEY=
LANGUAGE_HINTS=en,nl
# LIVE_PIPELINE=on
# LIVE_ASR=soniox
# SPEAKER_MATCH_THRESHOLD=0.6

# --- Refine pass (worker: pnpm --filter @hearloom/server worker) ---
# Re-diarizes each finished block of speech (≤ 20 min) on the Mac (build sidecars/diarizer first).
# REFINE=on
